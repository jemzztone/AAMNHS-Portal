APP_NAME="AAMNHS Attendance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

# Upload limits (XLSX import support)
PHP_MAX_INPUT_VARS=5000
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=12M

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - Use external database (MySQL/PostgreSQL) for Vercel
# SQLite does not work on Vercel's serverless functions
DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_SSLMODE=require

# Alternative: PostgreSQL (Neon, Supabase, etc.)
# DB_CONNECTION=pgsql
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_DATABASE=your-db-name
# DB_USERNAME=your-db-user
# DB_PASSWORD=your-db-password
# DB_SSLMODE=require

# Sessions - Database (no Redis needed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache - Database (no Redis needed)
CACHE_STORE=database

# Queue - Database + Vercel Cron (no Redis needed)
QUEUE_CONNECTION=database

# Queue Worker Secret (for cron authentication)
# Generate with: php artisan key:generate --show
QUEUE_WORKER_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

MEMCACHED_HOST=127.0.0.1

# Redis - Optional (remove if not using)
# REDIS_CLIENT=phpredis
# REDIS_HOST=your-redis-host
# REDIS_PASSWORD=your-redis-password
# REDIS_PORT=6379
# REDIS_TLS=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / Cloudflare R2 / Vercel Blob
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://your-bucket.s3.amazonaws.com
# For Cloudflare R2:
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# and set an authorized redirect URI to <APP_URL>/auth/google/callback
# Web Push (VAPID). Generate a key pair with:
# php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT="mailto:you@example.com"

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/auth/google/callback

# AI Assistant (Gemini)
AI_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=60